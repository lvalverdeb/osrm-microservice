#!/bin/sh
#
# PROVIDE: osrm_api_gateway
# REQUIRE: LOGIN osrm_routed redis
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable the OSRM API Gateway:
#
# osrm_api_gateway_enable (bool):   Set to NO by default. Set to YES to enable.
# osrm_api_gateway_user (str):      Unprivileged user to run as.
#                                   Default: osrmapi
# osrm_api_gateway_dir (str):       Application directory. Must contain .venv,
#                                   app/ and .env.
#                                   Default: /usr/local/www/osrm-api-gateway
# osrm_api_gateway_host (str):      Bind address. Default: 0.0.0.0
# osrm_api_gateway_port (int):      Bind port. Default: 8000
# osrm_api_gateway_logfile (str):   Log file.
#                                   Default: /var/log/osrm-api-gateway.log
# osrm_api_gateway_workers (int):   uvicorn worker processes. Default: 1
# osrm_api_gateway_forwarded_allow_ips (str): trusted proxy addresses/CIDRs,
#                                   comma-separated. Empty (default) keeps
#                                   uvicorn's 127.0.0.1-only trust, so
#                                   X-Forwarded-For is ignored.
# osrm_api_gateway_metrics_dir (str): Shared directory for Prometheus
#                                   multiprocess metrics. Only used when
#                                   workers > 1.
#                                   Default: /var/run/osrm_api_gateway-metrics

. /etc/rc.subr

name="osrm_api_gateway"
rcvar=${name}_enable

load_rc_config $name

: ${osrm_api_gateway_enable:="NO"}
: ${osrm_api_gateway_user:="osrmapi"}
: ${osrm_api_gateway_dir:="/usr/local/www/osrm-api-gateway"}
: ${osrm_api_gateway_host:="0.0.0.0"}
: ${osrm_api_gateway_port:="8000"}
: ${osrm_api_gateway_logfile:="/var/log/osrm-api-gateway.log"}
: ${osrm_api_gateway_workers:="1"}
: ${osrm_api_gateway_metrics_dir:="/var/run/${name}-metrics"}
: ${osrm_api_gateway_forwarded_allow_ips:=""}

_venv="${osrm_api_gateway_dir}/.venv"
_child_pidfile="/var/run/${name}.child.pid"

# Extra workers need a shared directory for metrics: prometheus_client counts
# in process memory, so without it each worker would report only its own share
# of the traffic. It picks its value class when the library is imported, so the
# variable must be in the environment before uvicorn starts -- rc.subr expands
# ${name}_env into an `env ...` prefix ahead of the command.
_workers_flag=""
case "$osrm_api_gateway_workers" in
    ''|*[!0-9]*)
        warn "osrm_api_gateway_workers=\"${osrm_api_gateway_workers}\" is not a number; using 1"
        osrm_api_gateway_workers=1
        ;;
    0|1) ;;
    *)
        _workers_flag="--workers ${osrm_api_gateway_workers}"
        osrm_api_gateway_env="PROMETHEUS_MULTIPROC_DIR=${osrm_api_gateway_metrics_dir}${osrm_api_gateway_env:+ ${osrm_api_gateway_env}}"
        ;;
esac

# uvicorn installs ProxyHeadersMiddleware by default but trusts only 127.0.0.1,
# so X-Forwarded-For from a balancer is ignored and every client collapses into
# one rate-limit bucket keyed on the balancer's address. Naming the proxies here
# makes the limiter key the real client again.
_proxy_flag=""
if [ -n "${osrm_api_gateway_forwarded_allow_ips}" ]; then
    if [ "${osrm_api_gateway_forwarded_allow_ips}" = "*" ]; then
        # "*" makes uvicorn trust every hop and take X-Forwarded-For[0], which
        # the client controls -- rate limiting can then be bypassed by spoofing.
        warn "osrm_api_gateway_forwarded_allow_ips=* trusts client-supplied X-Forwarded-For; name your proxies instead"
    fi
    _proxy_flag="--forwarded-allow-ips ${osrm_api_gateway_forwarded_allow_ips}"
fi

# Tracked pid is daemon(8) itself, the supervisor. SIGTERM to it reaps the
# child and exits without restarting, so `service osrm_api_gateway stop` is
# clean. procname therefore defaults to $command and needs no override.
#
# No -u here: osrm_api_gateway_user is ${name}_user, which rc.subr expands into
# "su -m ... -c" around the whole command, so daemon(8) already runs as that
# user. Passing -u as well would fail in the child, where restrict_process()
# calls setusercontext(LOGIN_SETALL) and that needs root.
pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-r -t ${name} \
    -P ${pidfile} -p ${_child_pidfile} -o ${osrm_api_gateway_logfile} \
    ${_venv}/bin/uvicorn app.main:app \
    --host ${osrm_api_gateway_host} --port ${osrm_api_gateway_port} ${_workers_flag} ${_proxy_flag}"

# Settings are read via Pydantic's SettingsConfigDict(env_file=".env"), which
# resolves relative to the working directory. Running from the app directory is
# what makes the deployed .env take effect -- same as running from the repo
# root in development.
osrm_api_gateway_chdir="${osrm_api_gateway_dir}"

start_precmd="${name}_precmd"

osrm_api_gateway_precmd()
{
    if [ ! -x "${_venv}/bin/uvicorn" ]; then
        err 1 "uvicorn not found in ${_venv} -- run 'make jail-up' first."
    fi
    if [ ! -f "${osrm_api_gateway_dir}/.env" ]; then
        warn "no .env in ${osrm_api_gateway_dir}; falling back to defaults in app/config.py"
    fi
    # This precmd is the last thing that runs as root: daemon(8) is unprivileged
    # by the time it opens these, and /var/run is not writable by the service
    # user, so both pidfiles and the log have to exist first.
    if [ -n "${_workers_flag}" ]; then
        # Files left by a previous run would be counted again by the collector,
        # so the directory starts empty.
        rm -rf "${osrm_api_gateway_metrics_dir}"
        install -d -o "${osrm_api_gateway_user}" -m 750 "${osrm_api_gateway_metrics_dir}"
    fi
    install -o "${osrm_api_gateway_user}" -m 644 /dev/null "${pidfile}"
    install -o "${osrm_api_gateway_user}" -m 644 /dev/null "${_child_pidfile}"
    install -o "${osrm_api_gateway_user}" -m 644 /dev/null "${osrm_api_gateway_logfile}"
}

run_rc_command "$1"
