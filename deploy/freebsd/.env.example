# FreeBSD jail deployment knobs.
#
# These are NOT app settings -- app settings live in deploy/env/app.env, which is
# shared with the Docker path and installed to ${JAIL_DIR}/.env by install.sh.
#
# Nothing reads this file directly. Copy the lines you need into the .env at the
# repository root, which the Makefile pulls in with `-include .env` + `export`.
#
# Every variable here is JAIL_-prefixed on purpose: the Makefile exports its whole
# environment, so an unprefixed OSRM_BASE_URL would leak a developer value into the
# jail. install.sh strips the prefix on the far side.

# --- reaching the jail ---
# SSH target is the HOST, not the jail: the jail runs no sshd of its own.
JAIL_HOST=developer@10.211.55.33
JAIL_NAME=api
JAIL_SSH_OPTS=-o StrictHostKeyChecking=accept-new

# Staging directories, on the host and inside the jail.
HOST_STAGE=/tmp/osrm-api-gateway-stage
JAIL_STAGE=/tmp/osrm-api-gateway-stage

# --- inside the jail ---
JAIL_DIR=/usr/local/www/osrm-api-gateway
JAIL_DATA_DIR=/var/db/osrm-backend
JAIL_APP_USER=osrmapi

# uvicorn bind and worker count. Workers > 1 also makes the rc.d script export
# PROMETHEUS_MULTIPROC_DIR so /metrics aggregates across them.
JAIL_API_HOST=0.0.0.0
JAIL_API_PORT=8000
JAIL_API_WORKERS=1

# Trusted proxy addresses/CIDRs, comma-separated. Leave empty unless a reverse
# proxy or load balancer fronts the gateway: uvicorn then ignores
# X-Forwarded-For and the rate limiter keys on the balancer's address, putting
# every client in one shared bucket. Never use "*" -- it makes uvicorn trust the
# client-supplied header, which lets any caller bypass rate limiting entirely.
# JAIL_FORWARDED_ALLOW_IPS=10.0.0.0/8

# Become OSRM_BASE_URL and REDIS_URL in the generated ${JAIL_DIR}/.env, overriding
# the shared block from deploy/env/app.env.
JAIL_OSRM_URL=http://127.0.0.1:5000
JAIL_REDIS_URL=redis://127.0.0.1:6379/0

# --- routing data ---
# GEO_URL lets the jail fetch the extract itself when no local data/*.osm.pbf was
# staged. The Docker path has no equivalent; it requires a local file.
PROFILE=car
OSM_FILE=costa-rica-latest.osm.pbf
GEO_URL=http://download.geofabrik.de/central-america/costa-rica-latest.osm.pbf
