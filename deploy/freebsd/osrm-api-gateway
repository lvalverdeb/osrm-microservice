#!/bin/sh
#
# PROVIDE: osrm_api_gateway
# REQUIRE: LOGIN osrm_routed redis
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable the OSRM API Gateway:
#
# osrm_api_gateway_enable (bool):   Set to NO by default. Set to YES to enable.
# osrm_api_gateway_user (str):      Unprivileged user to run as.
#                                   Default: osrmapi
# osrm_api_gateway_dir (str):       Application directory. Must contain the
#                                   osrm-api-gateway binary and .env.
#                                   Default: /usr/local/www/osrm-api-gateway
# osrm_api_gateway_host (str):      Bind address. Default: 0.0.0.0
# osrm_api_gateway_port (int):      Bind port. Default: 8000
# osrm_api_gateway_logfile (str):   Log file.
#                                   Default: /var/log/osrm-api-gateway.log
# osrm_api_gateway_workers (int):   tokio worker threads. Default: 1
#
# This runs the Rust gateway. Two knobs the FastAPI version needed are gone:
#
#   metrics_dir  -- workers are threads in one process sharing one metrics
#                   registry, so there is no multiprocess directory to prepare
#                   or wipe, and no under-reporting to avoid.
#   forwarded_allow_ips -- the binary reads FORWARDED_ALLOW_IPS from .env
#                   rather than taking a command-line flag. It cannot come
#                   through ${name}_env: rc.subr expands that unquoted, and the
#                   value `*` would glob against the working directory.
#
# The FastAPI implementation is kept as the rollback target; its script is
# osrm-api-gateway.python in this directory. See docs/deployment.md.

. /etc/rc.subr

name="osrm_api_gateway"
rcvar=${name}_enable

load_rc_config $name

: ${osrm_api_gateway_enable:="NO"}
: ${osrm_api_gateway_user:="osrmapi"}
: ${osrm_api_gateway_dir:="/usr/local/www/osrm-api-gateway"}
: ${osrm_api_gateway_host:="0.0.0.0"}
: ${osrm_api_gateway_port:="8000"}
: ${osrm_api_gateway_logfile:="/var/log/osrm-api-gateway.log"}
: ${osrm_api_gateway_workers:="1"}

_binary="${osrm_api_gateway_dir}/osrm-api-gateway"
_child_pidfile="/var/run/${name}.child.pid"

case "$osrm_api_gateway_workers" in
    ''|*[!0-9]*)
        warn "osrm_api_gateway_workers=\"${osrm_api_gateway_workers}\" is not a number; using 1"
        osrm_api_gateway_workers=1
        ;;
esac

# Only these three go through ${name}_env. rc.subr expands it unquoted into an
# `env ...` prefix, so a value containing a `;` would terminate the command --
# HEALTH_CHECK_COORDS is `0,0;0,0`, and everything else therefore has to reach
# the binary through .env instead.
osrm_api_gateway_env="HOST=${osrm_api_gateway_host} PORT=${osrm_api_gateway_port} WORKERS=${osrm_api_gateway_workers}${osrm_api_gateway_env:+ ${osrm_api_gateway_env}}"

# Tracked pid is daemon(8) itself, the supervisor. SIGTERM to it reaps the
# child and exits without restarting, so `service osrm_api_gateway stop` is
# clean. procname therefore defaults to $command and needs no override.
#
# No -u here: osrm_api_gateway_user is ${name}_user, which rc.subr expands into
# "su -m ... -c" around the whole command, so daemon(8) already runs as that
# user. Passing -u as well would fail in the child, where restrict_process()
# calls setusercontext(LOGIN_SETALL) and that needs root.
pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-r -t ${name} \
    -P ${pidfile} -p ${_child_pidfile} -o ${osrm_api_gateway_logfile} \
    ${_binary}"

# The binary reads .env from its working directory, the same rule
# pydantic-settings applied. Running from the app directory is what makes the
# deployed .env take effect -- same as running from the repo root in
# development.
osrm_api_gateway_chdir="${osrm_api_gateway_dir}"

start_precmd="${name}_precmd"

osrm_api_gateway_precmd()
{
    if [ ! -x "${_binary}" ]; then
        err 1 "no executable at ${_binary} -- run 'make jail-up' first."
    fi
    if [ ! -f "${osrm_api_gateway_dir}/.env" ]; then
        warn "no .env in ${osrm_api_gateway_dir}; falling back to built-in defaults"
    fi
    # This precmd is the last thing that runs as root: daemon(8) is unprivileged
    # by the time it opens these, and /var/run is not writable by the service
    # user, so both pidfiles and the log have to exist first.
    install -o "${osrm_api_gateway_user}" -m 644 /dev/null "${pidfile}"
    install -o "${osrm_api_gateway_user}" -m 644 /dev/null "${_child_pidfile}"
    install -o "${osrm_api_gateway_user}" -m 644 /dev/null "${osrm_api_gateway_logfile}"
}

run_rc_command "$1"
