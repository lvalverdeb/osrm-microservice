#!/bin/sh
#
# Shared implementation behind the osrm-routed services. This is *not* an rc.d
# script and carries no PROVIDE/REQUIRE header: install.sh writes one thin
# wrapper per profile into /usr/local/etc/rc.d, and those carry the header and
# source this file.
#
# Replaces the `osrm` rc.d script shipped by www/osrm-backend, which cannot
# start with any flags set. rc.subr expands ${name}_flags between the command
# and command_args -- "$command $rc_flags $command_args" -- so a non-empty
# osrm_flags reaches daemon(8) rather than osrm-routed, and daemon exits with
# "unrecognized option `--algorithm'". The engine's flags are part of
# command_args here, and no osrm_routed_flags variable exists to be expanded.
#
# The defaults mirror the osrm service in docker-compose.yml so both deployment
# paths serve the same engine configuration.
#
# MTX-1 needs one engine per routing profile, and one osrm-routed serves one
# built graph, so this runs as several instances. Each wrapper sets ${name} to
# a literal -- osrm_routed, osrm_routed_cycling, osrm_routed_walking -- and
# every knob below is read as ${name}_*, so the cycling instance is configured
# with osrm_routed_cycling_port and so on.
#
# ${name} must be a literal and cannot come from $0. /etc/rc *sources* rc.d
# scripts rather than executing them, so at boot $0 is the sourcing shell's,
# not the script's: the rcvar lookup then names a variable nobody sets,
# checkyesno returns false, and the engine silently does not start -- no error,
# no log line. That is how all three engines stayed down after the 2026-09-17
# reboot while the gateway, whose name was already a literal, came back. Every
# manual `service osrm_routed start` hid it, because executing the script does
# give $0 the right value.
#
# One implementation rather than three copies: the three differ only in a port
# and a data path, and three near-identical scripts drift the moment one is
# edited. The eval is what that costs; rc.subr offers no other way to read a
# variable whose name is not known until the script runs.
#
# ${name}_enable (bool):    Set to NO by default. Set to YES to enable.
# ${name}_user (str):       User to run as. Default: osrm
# ${name}_base (str):       Base path of the dataset, e.g.
#                           /var/db/osrm-backend/car/costa-rica-latest.osrm
#                           Required; has no default.
# ${name}_ip (str):         Bind address. Default: 127.0.0.1 (jail-local)
# ${name}_port (int):       Bind port. Default: 5000
# ${name}_max_trip_size (int): Waypoint cap for /trip. Default: 200
# ${name}_logfile (str):    Log file. Default: /var/log/${name}.log

. /etc/rc.subr

if [ -z "${name}" ]; then
    echo "osrm-routed: name unset -- source this from an rc.d wrapper" >&2
    exit 1
fi
rcvar=${name}_enable

load_rc_config $name

eval ": \${${name}_enable:=\"NO\"}"
eval ": \${${name}_user:=\"osrm\"}"
eval ": \${${name}_base:=\"\"}"
eval ": \${${name}_ip:=\"127.0.0.1\"}"
eval ": \${${name}_port:=\"5000\"}"
eval ": \${${name}_max_trip_size:=\"200\"}"
eval ": \${${name}_logfile:=\"/var/log/${name}.log\"}"

# Read once into fixed names, so the command below stays legible.
eval "_user=\${${name}_user}"
eval "_base=\${${name}_base}"
eval "_ip=\${${name}_ip}"
eval "_port=\${${name}_port}"
eval "_max_trip_size=\${${name}_max_trip_size}"
eval "_logfile=\${${name}_logfile}"

_child_pidfile="/var/run/${name}.child.pid"

# Tracked pid is daemon(8) itself, the supervisor; SIGTERM to it reaps the
# child and exits without restarting. Same shape as the gateway's script.
pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"

# No -u here: osrm_routed_user is ${name}_user, which rc.subr expands into
# "su -m ... -c" around the whole command, so daemon(8) already runs as that
# user. Passing -u as well would fail in the child, where restrict_process()
# calls setusercontext(LOGIN_SETALL) and that needs root.
#
# --algorithm mld is fixed: the data phase builds MLD data with osrm-partition
# and osrm-customize, and osrm-routed cannot serve it any other way.
command_args="-r -t ${name} \
    -P ${pidfile} -p ${_child_pidfile} -o ${_logfile} \
    /usr/local/bin/osrm-routed --algorithm mld \
    --ip ${_ip} --port ${_port} \
    --max-trip-size ${_max_trip_size} ${_base}"

# A fixed function name, not ${name}_precmd: rc.subr treats this as a command
# string, and with a per-instance ${name} it would look for a function named
# after the instance and fail the precmd for every one of them.
start_precmd="osrm_routed_precmd"

osrm_routed_precmd()
{
    if [ -z "${_base}" ]; then
        err 1 "${name}_base is unset -- run 'make jail-up' to configure it."
    fi
    # .osrm is a base path, not a file: osrm-routed reads ${base}.<suffix>
    # siblings and never opens ${base} itself. .cell_metrics is the last one
    # osrm-customize writes, so it is what "the data is built" means.
    if [ ! -f "${_base}.cell_metrics" ]; then
        err 1 "no routing data at ${_base}.* -- run 'make jail-data' first."
    fi
    # This precmd is the last thing that runs as root: daemon(8) is unprivileged
    # by the time it opens these, and /var/run is not writable by the service
    # user, so both pidfiles and the log have to exist first.
    install -o "${_user}" -m 644 /dev/null "${pidfile}"
    install -o "${_user}" -m 644 /dev/null "${_child_pidfile}"
    install -o "${_user}" -m 644 /dev/null "${_logfile}"
}

run_rc_command "$1"
