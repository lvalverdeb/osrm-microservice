# Docker deployment knobs.
#
# These are NOT app settings -- app settings live in deploy/env/app.env, which is
# shared with the FreeBSD jail path and loaded by this deployment via `env_file:`
# in docker-compose.yml.
#
# Nothing reads this file directly. Copy the lines you need into the .env at the
# repository root, which the Makefile pulls in with `-include .env` + `export`;
# the compose CLI then picks them up from its environment.

# Target a remote Docker daemon. Unset to use the local one.
DOCKER_HOST=tcp://10.211.55.28:2375

# Host-side published ports. The container always listens on 8000 internally, and
# OSRM on 5000 -- these only change what the host exposes.
API_PORT=8080
OSRM_PORT=5000

# Routing profile and OSM extract, used as build args for the OSRM data images.
PROFILE=car
OSM_FILE=costa-rica-latest.osm.pbf

# uvicorn worker processes. 1 by default, matching the FreeBSD jail. Above 1 the
# entrypoint also sets PROMETHEUS_MULTIPROC_DIR so /metrics aggregates across
# workers instead of reporting one worker's share. Each worker carries its own
# L1 cache and httpx pool, so memory grows with this.
API_WORKERS=1

# Trusted proxy addresses/CIDRs, comma-separated. Leave empty unless a reverse
# proxy or load balancer fronts the gateway: uvicorn then ignores
# X-Forwarded-For and the rate limiter keys on the balancer's address, putting
# every client in one shared bucket. Never use "*" -- it makes uvicorn trust the
# client-supplied header, which lets any caller bypass rate limiting entirely.
# FORWARDED_ALLOW_IPS=10.0.0.0/8
