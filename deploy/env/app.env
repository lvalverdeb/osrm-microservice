# Application settings, shared by BOTH deployment options.
#
# This is the single place app configuration is defined. It is loaded at runtime by:
#   Docker  -- deploy/docker/docker-compose.yml, via `env_file:`
#   Jail    -- copied to ${JAIL_DIR}/.env by deploy/freebsd/install.sh, where
#              pydantic-settings reads it (src/app/config.py sets env_file=".env",
#              and the rc.d script chdirs into the app directory)
#
# Every key here must be a field on Settings in src/app/config.py; the values below
# match its defaults. A test enforces both.
#
# NO SECRETS. This file is committed. Real process environment outranks it on both
# paths, so anything sensitive belongs there instead.
#
# OSRM_BASE_URL and REDIS_URL are overridden by each deployment -- Docker points at
# its service names, the jail at its loopback -- so editing them here has no effect.
# See docs/configuration.md.

# --- Core ---
OSRM_BASE_URL=http://localhost:5000
OSRM_API_URL=http://localhost:8080
APP_NAME=OSRM API Gateway
DEBUG=false

# --- Rate limiting ---
RATE_LIMIT_ROUTE=600/minute
RATE_LIMIT_MATRIX=300/minute
RATE_LIMIT_MATCH=600/minute
RATE_LIMIT_TRIP=300/minute
RATE_LIMIT_VRP=100/minute
RATE_LIMIT_NEAREST=600/minute
RATE_LIMIT_TILE=600/minute

# --- L2 cache (Redis) ---
REDIS_URL=
REDIS_TTL=900
REDIS_MAXSIZE=1024

# --- L1 cache (in-process) ---
L1_CACHE_TTL=900
L1_CACHE_MAXSIZE=1024

# --- Tracing ---
OTLP_ENDPOINT=

# --- OSRM client ---
OSRM_CLIENT_TIMEOUT=30
OSRM_RETRY_ATTEMPTS=3
OSRM_RETRY_MIN=1
OSRM_RETRY_MAX=10

# --- Health check ---
# Must stay well below the Docker HEALTHCHECK --timeout (8s) in
# deploy/docker/Dockerfile: this probe blocks the /health and /ready responses.
HEALTH_CHECK_TIMEOUT=2
HEALTH_CHECK_COORDS=0,0;0,0

# --- VRP / matrix ---
VRP_CHUNK_SIZE=80
MATRIX_BATCH_SIZE=500
VRP_HYSTERESIS_M=2000.0
VRP_SANITY_LIMIT_M=50000.0

# --- VRP capacity guards ---
# Peak memory is stops x concurrent solves: one 2000-stop solve peaked at 277 MB
# and four together reached 615 MB on a 2 GB host. Requests past VRP_MAX_STOPS get
# 422; requests that wait longer than VRP_QUEUE_TIMEOUT for a slot get 503.
# VRP_MAX_CONCURRENCY is per worker process, so node-wide concurrency is
# WORKERS x this value -- raise the two together, against a measured RSS ceiling.
VRP_MAX_STOPS=2000
VRP_MAX_CONCURRENCY=1
VRP_QUEUE_TIMEOUT=10.0

# --- Matrix capacity ---
# osrm-routed rejects sources x destinations above --max-table-size squared
# (default 100 => 10000 cells). Raising this requires passing --max-table-size
# to osrm-routed in both deploy/docker/docker-compose.yml and
# deploy/freebsd/osrm-routed, as the square root of this value.
MATRIX_MAX_CELLS=10000

# --- VRP chunk fan-out ---
# TSP chunks within one solve run concurrently, bounded by this. Node-wide
# concurrent /trip calls are WORKERS x VRP_MAX_CONCURRENCY x VRP_CHUNK_CONCURRENCY;
# past roughly twice the engine's core count they queue at osrm-routed instead.
VRP_CHUNK_CONCURRENCY=4

# --- Metrics ---
METRICS_ENDPOINT=/metrics

# --- Logging ---
APPEND_TO_STDERR=false
