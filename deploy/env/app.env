# Application settings, shared by BOTH deployment options.
#
# This is the single place app configuration is defined. It is loaded at runtime by:
#   Docker  -- deploy/docker/docker-compose.yml, via `env_file:`
#   Jail    -- copied to ${JAIL_DIR}/.env by deploy/freebsd/install.sh, where the
#              gateway reads it from its working directory (the rc.d script
#              chdirs into the app directory)
#
# Every key here must be a setting in gateway/src/config.rs; the values below
# match its defaults. Tests in that file enforce both directions.
#
# NO SECRETS. This file is committed. Real process environment outranks it on both
# paths, so anything sensitive belongs there instead.
#
# OSRM_BASE_URL and REDIS_URL are overridden by each deployment -- Docker points at
# its service names, the jail at its loopback -- so editing them here has no effect.
# See docs/configuration.md.

# --- Core ---
OSRM_BASE_URL=http://localhost:5000
OSRM_API_URL=http://localhost:8080
APP_NAME=OSRM API Gateway
DEBUG=false

# --- Rate limiting ---
RATE_LIMIT_ROUTE=600/minute
RATE_LIMIT_MATRIX=300/minute
RATE_LIMIT_MATCH=600/minute
RATE_LIMIT_TRIP=300/minute
RATE_LIMIT_VRP=100/minute
RATE_LIMIT_NEAREST=600/minute
RATE_LIMIT_TILE=600/minute

# --- L2 cache (Redis) ---
REDIS_URL=
REDIS_TTL=900
REDIS_MAXSIZE=1024

# --- L1 cache (in-process) ---
L1_CACHE_TTL=900
L1_CACHE_MAXSIZE=1024

# --- Tracing ---
OTLP_ENDPOINT=

# --- OSRM client ---
OSRM_CLIENT_TIMEOUT=30
OSRM_RETRY_ATTEMPTS=3
OSRM_RETRY_MIN=1
OSRM_RETRY_MAX=10

# --- Health check ---
# Must stay well below the Docker HEALTHCHECK --timeout (8s) in
# deploy/docker/Dockerfile: this probe blocks the /health and /ready responses.
HEALTH_CHECK_TIMEOUT=2
HEALTH_CHECK_COORDS=0,0;0,0

# --- VRP / matrix ---
VRP_CHUNK_SIZE=80
MATRIX_BATCH_SIZE=500
VRP_HYSTERESIS_M=2000.0
VRP_SANITY_LIMIT_M=50000.0

# --- VRP capacity guards ---
# Peak memory is stops x concurrent solves: one 2000-stop solve peaked at 277 MB
# and four together reached 615 MB on a 2 GB host. Requests past VRP_MAX_STOPS get
# 422; requests that wait longer than VRP_QUEUE_TIMEOUT for a slot get 503.
# VRP_MAX_CONCURRENCY is per worker process, so node-wide concurrency is
# WORKERS x this value -- raise the two together, against a measured RSS ceiling.
VRP_MAX_STOPS=2000
VRP_MAX_CONCURRENCY=1
VRP_QUEUE_TIMEOUT=10.0
# Past this many requests already queued for a solve slot, reject immediately
# rather than make the caller wait out VRP_QUEUE_TIMEOUT to be refused. A modest
# queue still waits, because a solve takes well under a second and waiting
# usually pays off.
#
# Defaults to 0, which disables the check and leaves the timeout as the only
# bound -- what the FastAPI gateway did, since it had no depth limit at all.
# Under a burst of concurrent solves a non-zero value refuses the excess in
# microseconds where waiting would often have served them, so it changes the
# shed rate rather than the ceiling. Raise it deliberately, against a measured
# queue, not by default.
VRP_MAX_QUEUE_DEPTH=0

# --- Matrix capacity ---
# osrm-routed rejects sources x destinations above --max-table-size squared
# (default 100 => 10000 cells). Raising this requires passing --max-table-size
# to osrm-routed in both deploy/docker/docker-compose.yml and
# deploy/freebsd/osrm-routed, as the square root of this value.
MATRIX_MAX_CELLS=10000

# --- Upstream request size ---
# OSRM takes coordinates in the URL path, so a long /match trace or a wide
# /matrix builds a request line of tens of kilobytes -- 1233 breadcrumbs came to
# 40 KB. Measured against osrm-routed directly: it answers up to ~24,750 bytes
# and drops the connection from ~25,000, which is why an over-long /match came
# back 500 instead of being refused. Requests that would cross this now get a 422
# naming the limit. Lower it if a proxy fronts the engine -- nginx and Apache cap
# a request line near 8 KB, well below what osrm-routed itself accepts.
OSRM_MAX_URL_BYTES=24000

# --- VRP chunk fan-out ---
# TSP chunks within one solve run concurrently, bounded by this. Node-wide
# concurrent /trip calls are WORKERS x VRP_MAX_CONCURRENCY x VRP_CHUNK_CONCURRENCY;
# past roughly twice the engine's core count they queue at osrm-routed instead.
VRP_CHUNK_CONCURRENCY=4

# --- API versioning (NFR-10) ---
# Every endpoint is served under /v1 and, during the deprecation window, at the
# root as well. Unversioned responses carry `Deprecation: true` and a `Link` to
# their /v1 successor; set this to an HTTP-date to add a `Sunset` header and
# commit to when the root paths stop being served. Empty announces the
# deprecation without a date, which is the honest default: only an operator
# knows what their integrators can migrate by.
# Example: API_SUNSET=Sun, 01 Mar 2026 00:00:00 GMT
API_SUNSET=

# --- Metrics ---
METRICS_ENDPOINT=/metrics

# --- Logging ---
APPEND_TO_STDERR=false
