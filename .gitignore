# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
# ...but deploy/env/ is the shared app-settings directory, not a virtualenv.
# On a case-insensitive filesystem (macOS default, core.ignorecase=true) the
# ENV/ pattern above matches it, so it must be re-included explicitly -- and as
# the directory, since git will not descend into an excluded one.
!deploy/env/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.agent/
.ruff_cache/
.mypy_cache/
dump.rdb
.claude/
.junie/

# OSRM Data (Large binary artifacts)
data/*
!data/.gitkeep
# If you want to keep the small .pbf file in git, uncomment the line below:
# !data/costa-rica-latest.osm.pbf

# Docker
.docker/
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment Secrets
.env
.env.local
.env.publish

# Docker build cache
.docker_tmp/

# uv cache
.uv_cache/

# Generated Mapbox Vector Tiles
*.mvt

# Scanner output (`make spaghetti`, `make fenceline`) -- regenerated on every run.
# NOTE: .fenceline-baseline.json is a committed config file, not a report. It does
# not match this pattern; do not widen the pattern so that it would.
*_report.json

# Rust evaluation spike build artifacts (255 MB). Cargo.lock stays tracked:
# it is a binary crate, and pinning keeps the benchmark reproducible.
rust-spike/target/

# Schemathesis crash cache -- regenerated on every run, and rewritten in place:
# a run that finds different cases deletes the previous ones, so committing it
# means every fuzz run produces unrelated churn in the diff. The reproducing
# case for anything worth keeping belongs in tests/, not here. There is no
# config under this path; schemathesis reads schemathesis.toml from the root.
.schemathesis/

# Interactive maps written by the example scripts -- folium output, regenerated
# on every run and often megabytes of embedded GeoJSON. Two had been committed
# (comparison_map.html, simple_vrp_map.html) and churned whenever anyone ran the
# examples.
examples/**/*.html
# The clustering payloads are written by the examples that post them, and are
# now derived from the committed corpus slice rather than from `random`. They
# used to be tracked, and every run of an example rewrote them.
examples/src/clustering/clustering_payload.json
examples/src/clustering/stress_test_payload.json
# match_example.py is the only script that writes to the working directory
# rather than beside itself, so it lands at the repository root. Named
# explicitly rather than matching /*.html, which would silently swallow any
# root page someone adds later.
/match_example_map.html

# Generated delivery dataset -- ~12 MB, and reproducible byte for byte from
# examples/src/vrp/generate_delivery_dataset.py with its committed seed, so
# committing it would add churn to every diff for no information.
# See docs/dataset_prep.md.
data/deliveries*.json
# The committed slice is the exception: examples and CI need a corpus,
# and generating the full one snaps 50,000 points through OSRM.
!examples/data/deliveries_sample.json
