# Local tooling only. Copy to .env (gitignored) and edit.
#
# The Makefile pulls this in with `-include .env` + `export`, so everything here
# reaches make recipes, the compose CLI, and the jail deployment.
#
# APP SETTINGS DO NOT BELONG HERE. All 29 of them live in deploy/env/app.env,
# which both deployments load at runtime -- Docker via `env_file:`, the jail by
# installing it to ${JAIL_DIR}/.env. Setting one here would change your local
# `uvicorn` run but neither deployment, which is exactly the drift to avoid.
# See docs/configuration.md.
#
# Deployment knobs are documented per option:
#   deploy/docker/.env.example    DOCKER_HOST, API_PORT, OSRM_PORT, ...
#   deploy/freebsd/.env.example   JAIL_HOST, JAIL_NAME, JAIL_API_*, ...
# Copy the lines you need from those into your .env.

# --- Docker ---
# Target a remote Docker daemon; unset to use the local one. The daemon is
# reached over SSH -- it publishes no TCP socket, so a tcp://host:2375 value
# fails with "Cannot connect to the Docker daemon".
DOCKER_HOST=ssh://developer@10.211.55.36

# --- routing data (both deployments) ---
PROFILE=car
OSM_FILE=costa-rica-latest.osm.pbf

# --- load testing ---
# Defaults to the jail (http://127.0.0.1:8000); Docker publishes 8080.
LOADTEST_URL=http://127.0.0.1:8000
LOADTEST_SCENARIO=route
LOADTEST_RATE=25
LOADTEST_DURATION=30

# --- publishing ---
# Required by `make publish`. Keep the real token in .env, never in .env.example.
UV_PUBLISH_TOKEN=
