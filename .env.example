# Docker Host (set to target a remote Docker daemon, e.g. tcp://10.211.55.28:2375)
# Leave empty to use the local Docker daemon.
DOCKER_HOST=tcp://10.211.55.28:2375

# OSRM Backend URL (internal — where the FastAPI gateway finds the OSRM engine)
OSRM_BASE_URL=http://10.211.55.28:5000

# OSRM API URL (public — where examples/clients find the FastAPI gateway)
OSRM_API_URL=http://10.211.55.28:8080

# Application
APP_NAME=OSRM API Gateway
DEBUG=false

# Rate Limiting (requests per time unit)
RATE_LIMIT_ROUTE=600/minute
RATE_LIMIT_MATRIX=300/minute
RATE_LIMIT_MATCH=600/minute
RATE_LIMIT_TRIP=300/minute
RATE_LIMIT_VRP=100/minute
RATE_LIMIT_NEAREST=600/minute
RATE_LIMIT_TILE=600/minute

# Redis Cache (empty = L1-only in-memory cache)
REDIS_URL=
REDIS_TTL=900
REDIS_MAXSIZE=1024

# L1 In-Memory Cache
L1_CACHE_TTL=900
L1_CACHE_MAXSIZE=1024

# OpenTelemetry Tracing (empty = tracing disabled)
OTLP_ENDPOINT=

# OSRM Client
OSRM_CLIENT_TIMEOUT=30
OSRM_RETRY_ATTEMPTS=3
OSRM_RETRY_MIN=1
OSRM_RETRY_MAX=10

# Health Check
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_COORDS=0,0;0,0

# VRP / Matrix
VRP_CHUNK_SIZE=80
MATRIX_BATCH_SIZE=500
VRP_HYSTERESIS_M=2000.0
VRP_SANITY_LIMIT_M=50000.0

# Metrics
METRICS_ENDPOINT=/metrics

# Logging
APPEND_TO_STDERR=false
